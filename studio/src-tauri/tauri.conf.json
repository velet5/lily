{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lily Studio",
  "mainBinaryName": "Lily Studio",
  "version": "0.1.0",
  "identifier": "io.github.velet5.lily-studio",
  "build": {
    "frontendDist": "../dist/web",
    "beforeBuildCommand": "node esbuild.mjs --production"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "copyright": "© Oleg Arshinskii",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../dist/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Developer ID Application: Oleg Arshinskii (KTSS95TY2K)",
      "hardenedRuntime": true
    }
  }
}
