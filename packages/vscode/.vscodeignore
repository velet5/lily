# Everything is excluded, then what the extension loads at run time is let back
# in (DECISIONS D23). A new run-time directory must be added here;
# `npm run test:e2e` fails when the packaged extension misses a file.
**

!package.json
!README.md
!CHANGELOG.md
!LICENSE
!AGENTS.md

# The two bundles; their source maps stay out.
!dist/extension.js
!dist/lily-check.js

# What esbuild.mjs copies from packages/common (D53): the webview scripts,
# runtime/, the grammar and the language configuration.
!dist/web/*.js
!dist/runtime/*.scm
!dist/runtime/timing.ly
!dist/syntaxes/lilypond.tmLanguage.json
!dist/language-configuration.json

# Webview styles and icons, snippets, IntelliSense data (D21).
!media/**
!snippets/lilypond.json
!data/completions.json

# README screenshots: relative links are not rewritten, so they must ship.
!docs/images/*.png

# Preview implementation notes linked from the README.
!docs/LIVE-PREVIEW-IMPLEMENTATION.md
!docs/LIVE-PREVIEW-RESEARCH.md
!docs/research/live-preview/implementation-results.json
!docs/research/live-preview/implementation-editor-results.json
!docs/research/live-preview/choir-results.json
!docs/research/live-preview/choir-profile.json
!docs/research/live-preview/choir-editor-before.json
!docs/research/live-preview/choir-editor-after.json
