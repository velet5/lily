{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lily Studio",
  "mainBinaryName": "Lily Studio",
  "version": "0.8.0",
  "identifier": "io.github.velet5.lily-studio",
  "build": {
    "frontendDist": "../dist/web",
    "beforeBuildCommand": "node esbuild.mjs --production"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'self' asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "copyright": "© Oleg Arshinskii",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../dist/runtime/": "runtime/"
    },
    "fileAssociations": [
      {
        "ext": [
          "ly"
        ],
        "name": "LilyPond score",
        "description": "LilyPond score",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-lilypond",
        "exportedType": {
          "identifier": "org.lilypond.lilypond-source",
          "conformsTo": [
            "public.plain-text"
          ]
        }
      },
      {
        "ext": [
          "ily",
          "lyi"
        ],
        "name": "LilyPond include file",
        "description": "LilyPond include file",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-lilypond",
        "exportedType": {
          "identifier": "org.lilypond.lilypond-include",
          "conformsTo": [
            "public.plain-text"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Developer ID Application: Oleg Arshinskii (KTSS95TY2K)",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxRDMxNzkwMjI4ODA0OEIKUldTTEJJZ2lrQmZUY1UrbG9KbCtrZWRRa20rcnM2by9haklkZ3FLV0hqVUtHcTd4WTAxZjI0TmQK",
      "endpoints": [
        "https://lily.everyday.fail/dist/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
