{
  "name": "lily",
  "displayName": "Lily — LilyPond",
  "description": "LilyPond editing with a side-by-side SVG preview, diagnostics and IntelliSense.",
  "version": "0.0.1",
  "publisher": "lily-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lilypond",
    "music",
    "notation",
    "score"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lilypond",
        "aliases": [
          "LilyPond",
          "lilypond"
        ],
        "extensions": [
          ".ly",
          ".ily"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilypond",
        "scopeName": "source.lilypond",
        "path": "./syntaxes/lilypond.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lilypond",
        "path": "./snippets/lilypond.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "test:grammar": "vscode-tmgrammar-snap \"test/grammar/*.ly\"",
    "test:grammar:update": "vscode-tmgrammar-snap --updateSnapshot \"test/grammar/*.ly\"",
    "pretest": "npm run check-types && node esbuild.mjs --tests && npm run test:grammar",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
