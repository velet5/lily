{
  "name": "lily",
  "displayName": "Lily — LilyPond",
  "description": "LilyPond editing with a side-by-side SVG preview, diagnostics and IntelliSense.",
  "version": "0.0.1",
  "publisher": "lily-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lilypond",
    "music",
    "notation",
    "score"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lilypond",
        "aliases": [
          "LilyPond",
          "lilypond"
        ],
        "extensions": [
          ".ly",
          ".ily"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilypond",
        "scopeName": "source.lilypond",
        "path": "./syntaxes/lilypond.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lilypond",
        "path": "./snippets/lilypond.json"
      }
    ],
    "commands": [
      {
        "command": "lily.compile",
        "title": "Compile",
        "category": "LilyPond"
      },
      {
        "command": "lily.showOutput",
        "title": "Show Output",
        "category": "LilyPond"
      },
      {
        "command": "lily.preview.openToSide",
        "title": "Open Preview to the Side",
        "category": "LilyPond"
      }
    ],
    "configuration": {
      "title": "Lily",
      "properties": {
        "lily.lilypond.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `lilypond` executable, or to the directory that contains it. Leave empty to search `PATH` and the usual install locations."
        },
        "lily.compile.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Extra command-line arguments for every `lilypond` run, one argument per item, for example `--include=/path/to/my library` or `-dno-point-and-click`."
        },
        "lily.preview.colors": {
          "type": "string",
          "enum": [
            "theme",
            "paper"
          ],
          "enumDescriptions": [
            "Draw the score in the editor's foreground colour on the editor's background.",
            "Draw the score in black on white pages, whatever the theme."
          ],
          "default": "theme",
          "scope": "window",
          "description": "Colours of the score preview."
        },
        "lily.preview.refreshOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Recompile and refresh an open preview when its file, or a file it reaches through `\\include`, is saved. When off, use **LilyPond: Compile**."
        },
        "lily.preview.refreshDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "scope": "window",
          "markdownDescription": "Milliseconds to wait after a save before recompiling for `#lily.preview.refreshOnSave#`. Saves that follow within the delay, such as **Save All**, lead to one compile."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "test:grammar": "vscode-tmgrammar-snap \"test/grammar/*.ly\"",
    "test:grammar:update": "vscode-tmgrammar-snap --updateSnapshot \"test/grammar/*.ly\"",
    "test:unit": "node esbuild.mjs --unit && node --test \"out/unit/**/*.test.js\"",
    "pretest": "npm run check-types && node esbuild.mjs --tests && npm run test:grammar && npm run test:unit",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
